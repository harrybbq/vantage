{
  "name": "vantage",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "eslint . && npm run check:visions && npm run check:parity && npm run check:boot && npm run check:savings && npm run check:training && vite build",
    "check:visions": "node scripts/check-vision-xp.mjs",
    "check:parity": "node scripts/check-ratings-parity.mjs",
    "check:boot": "node scripts/check-boot-speed.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "cap:sync": "VITE_NATIVE_BUILD=true npm run build && npx cap sync",
    "cap:android": "VITE_NATIVE_BUILD=true npm run build && npx cap sync android && npx cap open android",
    "cap:ios": "VITE_NATIVE_BUILD=true npm run build && npx cap sync ios && npx cap open ios",
    "cap:icons": "npx capacitor-assets generate",
    "lint": "eslint .",
    "check:savings": "node src/lib/savings/derive.test.mjs",
    "check:training": "node src/data/trainingProgramme.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/push-notifications": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@revenuecat/purchases-capacitor": "^13.0.1",
    "@revenuecat/purchases-capacitor-ui": "^13.0.1",
    "@supabase/supabase-js": "^2.100.1",
    "@tanstack/react-query": "^5.90.21",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "canvas-confetti": "^1.9.4",
    "cmdk": "^1.1.1",
    "fflate": "^0.8.3",
    "framer-motion": "^12.36.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.9.0",
    "vite": "^5.4.1",
    "vitest": "^2.0.5"
  }
}
