<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing leaves the device by backup or transfer. The
     WebView's storage holds the Supabase session and cached state;
     a copy on Google Drive or a new phone is a copy nobody signed in
     for. Users get their data back by signing in. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
