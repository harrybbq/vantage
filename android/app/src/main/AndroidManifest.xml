<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No backups of any kind. App storage holds the Supabase session
         and cached health/state data; allowBackup="true" copied it to
         Google Drive. allowBackup="false" covers Android 11 and below;
         on 12+ device-to-device transfer ignores it, so
         dataExtractionRules excludes everything there too. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Google/Apple sign-in returns here from the system browser
                 (src/lib/native/deepLinks.js). Scheme = bundle id; also
                 on Supabase's redirect allow-list. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.vantage.app" android:host="auth-callback" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Firebase Messaging must not mint an FCM token (or a Firebase
             installation id) at app start. The token is created only when
             the user opts in to notifications: requestPushPermission()
             calls PushNotifications.register(), which turns auto-init on
             (PushNotificationsPlugin.java setAutoInitEnabled(true)).
             unregister() turns it back off. Item 102 / labels M16. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Barcode scanning and the AI food scan open the camera through
         getUserMedia in the WebView (src/components/CameraScanner.jsx).
         Capacitor's BridgeWebChromeClient asks for CAMERA at runtime when
         the page requests it, and Android refuses the ask outright unless
         the permission is declared here. Asked only when a scan starts. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Not required: phones without a camera can still install the app
         (food search and manual logging work without one). -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Android 13+ runtime permission for notifications. The push plugin
         requests it only from requestPushPermission() (our own pre-prompt
         first); firebase-messaging also declares it, this makes it explicit. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- VIBRATE arrives from @capacitor/haptics' own manifest (merged). -->

    <!-- No advertising ID. Vantage has no ads or ad attribution, and the
         Play Data safety form declares none. Google Play services libraries
         can merge AD_ID in transitively; this strips it from the merged
         manifest whatever pulls it in. Check after `npx cap sync android`:
         app/build/intermediates/merged_manifests/release/AndroidManifest.xml
         must not contain com.google.android.gms.permission.AD_ID. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
</manifest>
